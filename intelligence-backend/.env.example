# ─────────────────────────────────────────
# VaoVao Intelligence — variables de entorno
# Copia como .env y llena los valores. NUNCA subas .env a Git.
# ─────────────────────────────────────────

# Base de datos (en Railway usa: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intelligence

# Llave para firmar los JWT — GENERA UNA FUERTE:  openssl rand -hex 32
SECRET_KEY=cambia-esto-por-una-llave-fuerte

# Llave para cifrar credenciales (token de Meta). GENERA UNA con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# RESPALDA ESTE VALOR fuera del servidor (gestor de contraseñas). Si se pierde,
# las credenciales de Meta ya guardadas quedan ilegibles y NO se recuperan:
# hay que volver a capturarlas. No sirve restaurar un backup de la base, porque
# lo que se pierde no son los datos sino la llave que los abre.
ENCRYPTION_KEY=

# Para ROTAR la llave sin romper lo ya guardado. Lista separada por comas:
# la primera cifra lo nuevo, todas se prueban al descifrar. Manda sobre
# ENCRYPTION_KEY si ambas están definidas.
#
#   1) ENCRYPTION_KEYS="<nueva>,<anterior>"   <- nada se rompe
#   2) python -m scripts.recifrar_credenciales --apply
#   3) ENCRYPTION_KEYS="<nueva>"              <- recién ahora se retira
#
# Saltarse el paso 2 deja las credenciales ilegibles para siempre.
ENCRYPTION_KEYS=

# Opcionales (tienen defaults razonables)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development
